# DEC-08: sin access log del proxy: la URI WS contiene ticket one-time.
# Los logs HTTP seguros los emite Python, sin querystring ni bodies.
request_body {
	max_size 131072
}
@internal path /metrics /health/ready /docs /docs/* /redoc /openapi.json
respond @internal 404

@wrong_upgrade {
	header Upgrade websocket
	not path /ws/v1
}
respond @wrong_upgrade 404

@api path /api/v1/* /ws/v1 /health/live
handle @api {
	reverse_proxy python:8000 {
		# DEC-37: se sobrescribe; la API solo confía si el peer TCP es Caddy.
		header_up X-Chat-Client-IP {remote_host}
		health_uri /health/ready
		health_interval 5s
		health_timeout 2s
		health_status 200
		fail_duration 5s
		max_fails 1
		unhealthy_status 503
		transport http {
			dial_timeout 3s
			response_header_timeout 15s
		}
	}
}
@web path / /index.html /app.js /api.js /styles.css /keys.js /keys-ui.js /vendor/sodium.js /vendor/sodium.LICENSE.txt
handle @web {
	root * /srv/chat-web
	header {
		Content-Security-Policy "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		Cache-Control "no-store"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}
	file_server
}
handle {
	respond 404
}
