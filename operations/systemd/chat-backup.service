[Unit]
Description=Backup lógico cifrado Chat
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=chat-ops
WorkingDirectory=/opt/chat
EnvironmentFile=/etc/chat/backup.env
ExecStart=/opt/chat/.venv/bin/python /opt/chat/operations/backup_job.py backup
RuntimeDirectory=chat-backup
RuntimeDirectoryMode=0700
TimeoutStartSec=2h
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/chat/backups /opt/chat/artifacts/operations
LimitCORE=0
